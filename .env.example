# BEH4VIOR runtime configuration. Names only: never commit real values.
NODE_ENV=production
PORT=3000

# Public origin of this deployment. Writes from any other origin are refused.
BEH4VIOR_PUBLIC_ORIGIN=https://beh4vior.takatak.ca

# TAKATAK-V1 sign-in bridge (V1 owns identity; see docs/TAKATAK_V1_BRIDGE.md).
TAKATAK_BEH4VIOR_LAUNCH_URL=https://takatak.ca/api/experiences/beh4vior/launch
TAKATAK_BEH4VIOR_EXCHANGE_URL=https://takatak.ca/api/experiences/beh4vior/exchange
# Dedicated long random secret, identical to TAKATAK_BEH4VIOR_SERVICE_TOKEN in V1. 20 characters minimum.
TAKATAK_BEH4VIOR_SERVICE_TOKEN=
# Independent signing key for this app's own session cookie. 32 characters minimum. Never shared with V1.
BEH4VIOR_SESSION_SECRET=

# Postgres for the sheets. The table is created at startup. Required in production.
DATABASE_URL=

# Local development only; ignored when NODE_ENV=production.
# BEH4VIOR_DEMO=1        page with invented example data, saved in the browser
# BEH4VIOR_DEV_LOGIN=1   skip V1 and sign in as a local test account
